<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- =====================================================================
         Storage
         =====================================================================
         MANAGE_EXTERNAL_STORAGE ("All files access") is what lets Zai-Bridge
         browse the handset for old APK/OBB pairs the way a desktop launcher
         browses a folder. The legacy read/write pair is kept for API <= 29,
         where there is no per-app "all files" grant to ask for.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- =====================================================================
         Permissions the *guests* rely on.
         =====================================================================
         A virtualized Activity runs under this package, so a permission its own
         manifest declared is not granted to us. These are the normal-level
         grants legacy games assume; each one is enforced by the framework at
         the call site, so requesting them here is what keeps a guest's
         onCreate/onResume from throwing SecurityException.
    -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Importing a multi-gigabyte OBB must survive the user leaving the app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Enumerate installed 64-bit and 32-bit games/split APKs on Android 11–16+ -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".core.BridgeApplication"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZaiBridge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ZaiBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.CrashActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ZaiBridge" />

        <!-- =================================================================
             The virtualized execution surface.

             ProxyGameActivity is a real, manifest-declared Activity: launching
             it makes ActivityThread run performLaunchActivity, which is where
             the Window, DecorView, FragmentController and InputChannel are
             created. BridgeInstrumentation substitutes the imported game's own
             Activity in newActivity(), so the guest inherits all of that
             plumbing instead of being hand-attached through reflection.

             The configChanges below are the full set a game needs: rotation,
             keyboard, density and UI mode changes are delivered to the guest
             instead of recreating (and restarting) it.
        -->
        <activity
            android:name=".proxy.ProxyGameActivity"
            android:process=":guest"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|locale|layoutDirection|touchscreen"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="standard"
            android:resizeableActivity="false"
            android:theme="@style/Theme.ZaiBridge.GameHost" />

        <!-- =================================================================
             The direct execution surface used when the instrumentation hook is
             unavailable. NoActionBar/Fullscreen comes from the theme, and the
             activity additionally drives the SystemUI flags so the emulated
             game is never letterboxed into a window.
        -->
        <activity
            android:name=".GameHostActivity"
            android:process=":guest"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|locale|layoutDirection|touchscreen"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:theme="@style/Theme.ZaiBridge.GameHost" />

        <service
            android:name=".service.IngestionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />
    </application>

</manifest>
