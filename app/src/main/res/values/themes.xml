<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Launcher shell: Material 3 dark, edge-to-edge, no action bar. -->
    <style name="Theme.ZaiBridge" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/zb_accent</item>
        <item name="colorOnPrimary">@color/zb_on_accent</item>
        <item name="colorPrimaryContainer">@color/zb_accent_deep</item>
        <item name="colorOnPrimaryContainer">@color/zb_text</item>
        <item name="colorSecondary">@color/zb_amber</item>
        <item name="colorOnSecondary">@color/zb_on_accent</item>
        <item name="colorSurface">@color/zb_surface</item>
        <item name="colorOnSurface">@color/zb_text</item>
        <item name="colorSurfaceVariant">@color/zb_surface_high</item>
        <item name="colorOnSurfaceVariant">@color/zb_text_dim</item>
        <item name="colorOutline">@color/zb_outline</item>
        <item name="android:colorBackground">@color/zb_background</item>
        <item name="android:windowBackground">@color/zb_background</item>
        <item name="android:colorAccent">@color/zb_accent</item>
        <item name="android:textColorPrimary">@color/zb_text</item>
        <item name="android:textColorSecondary">@color/zb_text_dim</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialButtonStyle">@style/Widget.ZaiBridge.Button</item>
    </style>

    <style name="Widget.ZaiBridge.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.ZaiBridge.Cta" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textColor">@color/zb_on_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="Widget.ZaiBridge.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textAllCaps">false</item>
        <item name="chipBackgroundColor">@color/zb_chip_selector</item>
        <item name="android:textColor">@color/zb_chip_text_selector</item>
        <item name="chipStrokeColor">@color/zb_chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="TextAppearance.ZaiBridge.Metric" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/zb_text_dim</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- =====================================================================
         Game host. The explicit NoTitleBar + Fullscreen parent is what removes
         every trace of the host: no title bar, no decor window, and the
         activity then clears the system bars itself.
    -->
    <style name="Theme.ZaiBridge.GameHost" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@color/zb_black</item>
        <item name="android:colorBackground">@color/zb_black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

</resources>
