<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp">

        <!-- Glass header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_emblem" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.03"
                    android:text="@string/app_name"
                    android:textColor="@color/zb_text"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="@string/app_tagline"
                    android:textColor="@color/zb_text_dim"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_graphics_defaults"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/engine_settings"
                android:padding="11dp"
                android:src="@drawable/ic_tune" />
        </LinearLayout>

        <!-- Detected hardware (tap to open Hardware & SoC Inspector) -->
        <TextView
            android:id="@+id/tv_hardware"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_status_pill"
            android:clickable="true"
            android:drawableStart="@drawable/ic_shield"
            android:drawablePadding="7dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:letterSpacing="0.04"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="13dp"
            android:paddingBottom="7dp"
            android:textColor="@color/zb_accent"
            android:textSize="10.5sp"
            tools:text="ARM64 · Hardware GPU active · Tap to inspect" />

        <!-- Library search + Grid/List view toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:hint="@string/search_games"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/zb_text"
                android:textColorHint="@color/zb_text_faint"
                android:textSize="13.5sp" />

            <ImageButton
                android:id="@+id/btn_view_toggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/toggle_layout_view"
                android:padding="12dp"
                android:src="@drawable/ic_view_list" />
        </LinearLayout>

        <!-- Library category filter chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_library_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@id/chip_filter_all"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_all"
                    style="@style/Widget.ZaiBridge.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filter_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_32bit"
                    style="@style/Widget.ZaiBridge.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_32bit" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_64bit"
                    style="@style/Widget.ZaiBridge.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_64bit" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_unity"
                    style="@style/Widget.ZaiBridge.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_unity" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_filter_obb"
                    style="@style/Widget.ZaiBridge.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_obb" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Storage permission banner -->
        <LinearLayout
            android:id="@+id/banner_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="11dp"
            android:paddingEnd="10dp"
            android:paddingBottom="11dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_permission"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="@string/permission_body"
                android:textColor="#FFE0B2"
                android:textSize="11.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_grant"
                style="@style/Widget.ZaiBridge.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="@string/permission_action"
                android:textSize="11.5sp"
                app:backgroundTint="@color/zb_amber"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_games"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="2dp"
                android:paddingTop="4dp"
                android:paddingEnd="2dp"
                android:paddingBottom="102dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="70dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:alpha="0.9"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_emblem" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/empty_title"
                    android:textColor="@color/zb_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="290dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/empty_body"
                    android:textColor="@color/zb_text_dim"
                    android:textSize="12.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_import"
                    style="@style/Widget.ZaiBridge.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/import_first"
                    android:textColor="@color/zb_on_accent"
                    android:textSize="13sp"
                    app:backgroundTint="@color/zb_accent"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btn_import"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:text="@string/import_game"
        android:textAllCaps="false"
        android:textColor="@color/zb_on_accent"
        android:textSize="13.5sp"
        android:textStyle="bold"
        app:backgroundTint="@color/zb_accent"
        app:elevation="10dp"
        app:icon="@drawable/ic_import"
        app:iconTint="@color/zb_on_accent"
        app:rippleColor="#3304121A" />

    <!-- Loading Overlay for background game staging -->
    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D00A0F14"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/zb_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.04"
            android:text="Preparing Game Engine..."
            android:textColor="@color/zb_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.02"
            android:text="Staging 32-bit runtime arena and assets"
            android:textColor="@color/zb_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
