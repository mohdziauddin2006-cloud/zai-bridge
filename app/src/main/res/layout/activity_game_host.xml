<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zb_black">

    <!-- Legacy games keep their own aspect ratio; the container letterboxes. -->
    <com.ziauddin.zaibridge.AspectRatioFrameLayout
        android:id="@+id/game_aspect"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- The guest presents into this surface once the bridge is up. -->
        <SurfaceView
            android:id="@+id/game_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.ziauddin.zaibridge.AspectRatioFrameLayout>

    <LinearLayout
        android:id="@+id/status_wrap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_status_pill"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="20dp"
        android:paddingEnd="26dp"
        android:paddingBottom="20dp">

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminateTint="@color/zb_accent" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="300dp"
            android:text="@string/bridge_starting"
            android:textColor="@color/zb_text"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
